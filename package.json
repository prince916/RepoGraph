{
	"name": "repograph",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --passWithNoTests",
		"test": "npm run test:unit",
		"db:migrate": "node --env-file-if-exists=.env db/migrate.ts",
		"worker": "uv run --env-file .env python workers/worker_loop.py",
		"worker:watchdog": "uv run --env-file .env python workers/worker_loop.py --watchdog",
		"test:py": "uv run pytest tests/unit",
		"test:py:integration": "uv run --env-file .env pytest tests/integration"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3": "^7.4.3",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#analysis/*": "./packages/analysis/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
		"d3": "7.9.0",
		"jszip": "^3.10.1",
		"postgres": "^3.4.9"
	},
	"engines": {
		"node": ">=22.18"
	}
}
